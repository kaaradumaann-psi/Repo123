r; color: rgb(13, 148, 136);">27</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(234, 179, 8);">60.7</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(234, 179, 8);">Orta Yüksek</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Kadınlık-Erkeklik (Mf)</td><td style="padding: 6px 10px; text-align: center;">28</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">—</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(34, 197, 94);">46.8</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(34, 197, 94);">Normal</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Paranoya (Pa)</td><td style="padding: 6px 10px; text-align: center;">23</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">—</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">79.5</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">Yüksek</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Psikasteni (Pt)</td><td style="padding: 6px 10px; text-align: center;">32</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">40</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(249, 115, 22);">69.2</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(249, 115, 22);">Orta Yüksek</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Şizofreni (Sc)</td><td style="padding: 6px 10px; text-align: center;">51</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">59</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">82.2</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">Çok Yüksek</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Hipomani (Ma)</td><td style="padding: 6px 10px; text-align: center;">35</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">37</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">88.7</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">Çok Yüksek</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 6px 10px; font-weight: 700; color: rgb(109, 40, 217);">Sosyal İçedönüklük (Si)</td><td style="padding: 6px 10px; text-align: center;">41</td><td style="padding: 6px 10px; text-align: center; color: rgb(13, 148, 136);">—</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">71.5</td><td style="padding: 6px 10px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">Yüksek</td></tr></tbody></table></div><div style="font-size: 10px; display: flex; flex-direction: column; gap: 10px;"><h4 style="margin: 0px 0px 10px; font-size: 11px; font-weight: 700; color: rgb(30, 41, 59); border-bottom: 1px solid rgb(203, 213, 225); padding-bottom: 4px;">Klinik Ölçek Yorumları (Yükselen Profiller)</h4><div style="display: flex; flex-direction: column; gap: 8px;"><div style="border: 1px solid rgb(226, 232, 240); border-radius: 6px; padding: 10px; background-color: rgb(248, 250, 252);"><span style="font-weight: 800; color: rgb(34, 197, 94);">Depresyon (D) — T Skoru: 48.7 (Normal)</span><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); line-height: 1.4; text-align: justify; font-size: 9.5px;">Bu, bireyin yaşamında iyimserlik ve karamsarlık dengesini kurduğunun göstergesidir.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 6px; padding: 10px; background-color: rgb(248, 250, 252);"><span style="font-weight: 800; color: rgb(234, 179, 8);">Psikopatik Sapma (Pd) — T Skoru: 60.7 (Orta Yüksek)</span><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); line-height: 1.4; text-align: justify; font-size: 9.5px;">Risk alabilen, enerjik, sosyal, maceraperest ve atılgan olan bir bireyle bağlantılıdır. Ancak, bu bireyler engellendiklerinde bu özellikler huzursuzluk, saldırganlık ve sosyal olarak uyumlu olmayan davranış biçimine dönüşebilir.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 6px; padding: 10px; background-color: rgb(248, 250, 252);"><span style="font-weight: 800; color: rgb(239, 68, 68);">Paranoya (Pa) — T Skoru: 79.5 (Yüksek)</span><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); line-height: 1.4; text-align: justify; font-size: 9.5px;">Diğerlerini suçlama ve hostilite temel özelliklerdir. Bu bireyler katı, inatçı ve aşırı duyarlıdırlar. Kişilerarası ilişkilerde aşırı savunucu tutumları nedeniyle yanlış anlaşılabilirler. Açık paranoid özellikler vardır.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 6px; padding: 10px; background-color: rgb(248, 250, 252);"><span style="font-weight: 800; color: rgb(249, 115, 22);">Psikasteni (Pt) — T Skoru: 69.2 (Orta Yüksek)</span><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); line-height: 1.4; text-align: justify; font-size: 9.5px;">Bu yükseltiler dürüst, mükemmeliyetçi, titiz ve kendini eleştiren bireyler olduklarına işaret etmektedir. Küçük sorunları bile kendilerine dert etme eğilimindedirler.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 6px; padding: 10px; background-color: rgb(248, 250, 252);"><span style="font-weight: 800; color: rgb(239, 68, 68);">Şizofreni (Sc) — T Skoru: 82.2 (Çok Yüksek)</span><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); line-height: 1.4; text-align: justify; font-size: 9.5px;">Yabancılaşma yaşayan ve doğru düşünemeyen bireyler tarafından verilir. Düşüncede ve hareketlerde sıradan değildirler, olasılıkla sosyal açıdan çekiniktirler ve derin kişilerarası ilişki kuramazlar. Kendilerinin kim olduğu ve bu dünyadaki yerlerinin ne olduğu konusunda oldukça bozuk düşünceleri vardır ve genellikle bu dünyaya ait olmadıklarını düşünürler. İletişim kurmada sorunlar temeldir, dezorganize düşünceleri vardır ve bunların açık ve mantıklı düşünmesini engeller. Bireylerin gerçek ile bağlantıları var gibi görünse de bu oldukça yüzeyseldir. Alt test 8’deki yüksek puanlar, gerçek psikotik düşünce bozukluğunu yansıtabilecek soğuk, apatik, yabancılaşma, düşünme, iletişim ve anlamada bozulma olması gibi özellikleri gösterebilir. Kişilerarası ilişkiler yerine hayalleri ve fantezileri yeğlerler. Aşağılık duyguları, kendinden hoşnutsuzluk ve yalnızlık duyguları içindedirler. T Puanı 80’e yaklaştığında, mantıkta ve düşünmede tuhaflık belirginleşir. Gerçek şizoid düşünce süreci gözlenebilir. Bunlara depresif özellikler ve psikomotor gerileme eşlik eder. Davranışlar ya şizofrenik bir sürecin ya da şizoid bir uyumun ya da uzun süreli ciddi bir stresin sonucu olabilir.</p></div></div></div></div><div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(226, 232, 240); padding-top: 8px; font-size: 9px; color: rgb(100, 116, 139);"><span>MMPI Analiz Raporlama Sistemi | Danışan: Belirtilmedi</span><span>Sayfa 3 / 5</span></div></div><div class="pdf-report-page" style="width: 794px; height: 1123px; padding: 50px 45px 40px; background-color: rgb(255, 255, 255); color: rgb(15, 23, 42); font-family: system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; position: relative;"><div><div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid rgb(13, 148, 136); padding-bottom: 10px; margin-bottom: 20px;"><div><h1 style="margin: 0px; font-size: 18px; font-weight: 900; color: rgb(13, 148, 136); letter-spacing: -0.5px;">MMPI KİŞİLİK ENVANTERİ</h1><p style="margin: 2px 0px 0px; font-size: 9px; font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; letter-spacing: 1px;">Türetilmiş Ölçekler &amp; Endeksler</p></div><div style="text-align: right; font-size: 9px; color: rgb(100, 116, 139);"><p style="margin: 0px; font-weight: 700; color: rgb(30, 41, 59);">Klinik Raporlama</p><p style="margin: 0px;">Tarih: 18.09.2026</p></div></div><div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 15px; margin-bottom: 20px; font-size: 10px;"><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(248, 250, 252);"><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block; margin-bottom: 4px;">Goldberg Ayrım Endeksi</span><div style="display: flex; align-items: baseline; gap: 6px;"><span style="font-size: 16px; font-weight: 800; color: rgb(124, 58, 237);">82.39999999999998</span><span style="font-size: 9px; font-weight: 700; color: rgb(124, 58, 237);">(Psikotik Profil Eğilimi)</span></div><p style="margin: 4px 0px 0px; color: rgb(71, 85, 105); font-size: 9px; line-height: 1.3;">Psikotik profil örüntüsü göstergesi (Goldberg Endeksi &gt; 45).</p></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(248, 250, 252); display: flex; flex-direction: column; gap: 8px;"><div><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block;">Taulbee İndeksi</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 11px;">0 (Nevrotik/Psikotik Ayrımı)</span></div><div style="border-top: 1px solid rgb(203, 213, 225); padding-top: 6px;"><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block;">Peterson İndeksi</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 11px;">0 (Psikotik Yük Skoru)</span></div></div></div><div style="margin-bottom: 20px;"><h4 style="margin: 0px 0px 8px; font-size: 11px; font-weight: 700; color: rgb(30, 41, 59); border-bottom: 1px solid rgb(203, 213, 225); padding-bottom: 4px;">Kişilik Bozukluğu Eğilimleri (DSM-III Ham Puan Seviyeleri)</h4><div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 9px;"><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(51, 65, 85);">Histrionik Kişilik Özellikleri</span><span style="color: rgb(100, 116, 139);">Puan: 3 (Normal Sınırlar)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Normal sınırlar.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(254, 242, 242);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(185, 28, 28);">Narsisistik Kişilik Özellikleri</span><span style="color: rgb(185, 28, 28);">Puan: 14 (Belirgin Özellikler)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Belirgin Narsisistik özellikler: Kendini aşırı önemseme, empati eksikliği, sınırsız başarı hayalleri ve başkalarını kullanma eğilimi.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(254, 242, 242);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(185, 28, 28);">Antisosyal Kişilik Özellikleri</span><span style="color: rgb(185, 28, 28);">Puan: 17 (Belirgin Özellikler)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Belirgin Antisosyal özellikler: Sosyal normlara uyumda güçlük, dürtüsellik, dürüst olmama, pişmanlık eksikliği ve saldırganlık eğilimi.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(254, 242, 242);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(185, 28, 28);">Sınır (Borderline) Kişilik Özellikleri</span><span style="color: rgb(185, 28, 28);">Puan: 16 (Belirgin Özellikler)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Belirgin Borderline (Sınır) özellikler: İlişkilerde ve duygularda dengesizlik, kimlik karmaşası, terkedilme korkusu ve dürtüsel davranışlar.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(51, 65, 85);">Bağımlı Kişilik Özellikleri</span><span style="color: rgb(100, 116, 139);">Puan: 5 (Normal Sınırlar)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Normal sınırlar.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(51, 65, 85);">Obsesif-Kompulsif Kişilik Özellikleri</span><span style="color: rgb(100, 116, 139);">Puan: 10 (Hafif Eğilimler)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Hafif Obsesif eğilimler: Titizlik, sorumluluk bilincinin yüksekliği.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(51, 65, 85);">Pasif-Agresif Kişilik Özellikleri</span><span style="color: rgb(100, 116, 139);">Puan: 9 (Normal Sınırlar)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Pasif-Agresif özellikler: Taleplere karşı dolaylı direnç gösterme, surat asma, erteleme ve inatçılık.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><div style="display: flex; justify-content: space-between; font-weight: 700;"><span style="color: rgb(51, 65, 85);">Paranoid Kişilik Özellikleri</span><span style="color: rgb(100, 116, 139);">Puan: 19 (Normal Sınırlar)</span></div><p style="margin: 2px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Paranoid özellikler: Başkalarına karşı aşırı güvensizlik, kuşkuculuk, olayları kötü niyetli yorumlama ve kin tutma.</p></div></div></div><div><h4 style="margin: 0px 0px 8px; font-size: 11px; font-weight: 700; color: rgb(30, 41, 59); border-bottom: 1px solid rgb(203, 213, 225); padding-bottom: 4px;">Madde Bağımlılığı ve Diğer Özel Ölçekler</h4><div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; font-size: 9px;"><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">MacAndrew Alkolizm Ölçeği (MAC)</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 26</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Belirgin Alkolizm Riski (Ham Puan ≥ 22): Türkiye normlarına göre (Ceyhun ve Palabıyıkoğlu, 1989) kesme puanının üzerindedir. Alkol kullanımı veya madde kötüye kullanımı potansiyeli açısından klinik değerlendirme yapılması önerilir. İmpulsif, dışadönük ve risk alma eğilimi eşlik edebilir.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">ICAS Alkolizm Ölçeği</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 4</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Normal sınırlar.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">Madde Kullanım Eğilimi Ölçeği (SAP)</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 23</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Madde Kullanım Eğilimi (Pozitif): Türkiye örnekleminde %84 doğruluk veren kesme puanının üzerindedir. Madde kullanma eğilimi, dürtüsellik ve risk alma davranışları açısından anlamlı risk taşır.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">Aşırı Kontrol Edilmiş Düşmanlık (O-H)</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 12</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Normal sınırlar.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">Barron Ego Gücü Ölçeği (Es)</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 21</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Düşük Ego Gücü: Psikolojik kaynakların yetersizliği, düşük özgüven ve duygusal zorluklarla başa çıkmada güçlük. Psikolojik uyum ciddi şekilde bozulmuştur ve sorunlar uzun süredir kronik olarak devam etmektedir. Danışanın sorunlarla başa çıkmada kullanabileceği kişisel kaynaklar son derece kısıtlıdır; psikoterapi prognozu zayıftır.</p></div><div style="border: 1px solid rgb(226, 232, 240); border-radius: 5px; padding: 8px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(13, 148, 136); display: block;">Welsh Anksiyete Ölçeği (A)</span><span style="font-weight: 700; color: rgb(51, 65, 85); font-size: 10px;">Puan: 19</span><p style="margin: 3px 0px 0px; color: rgb(100, 116, 139); font-size: 8.5px; line-height: 1.2;">Normal Anksiyete (T-Skoru: 45-59, T: 55): Davranışlarını, duygularını ve sorunlarını tartışmak için uygun düzeyde bir istek ve içgörü gösterir.</p></div></div></div></div><div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(226, 232, 240); padding-top: 8px; font-size: 9px; color: rgb(100, 116, 139);"><span>MMPI Analiz Raporlama Sistemi | Danışan: Belirtilmedi</span><span>Sayfa 4 / 5</span></div></div><div class="pdf-report-page" style="width: 794px; height: 1123px; padding: 50px 45px 40px; background-color: rgb(255, 255, 255); color: rgb(15, 23, 42); font-family: system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; position: relative;"><div><div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid rgb(13, 148, 136); padding-bottom: 10px; margin-bottom: 20px;"><div><h1 style="margin: 0px; font-size: 18px; font-weight: 900; color: rgb(13, 148, 136); letter-spacing: -0.5px;">MMPI KİŞİLİK ENVANTERİ</h1><p style="margin: 2px 0px 0px; font-size: 9px; font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; letter-spacing: 1px;">Kritik Bulgular, Notlar &amp; Onay</p></div><div style="text-align: right; font-size: 9px; color: rgb(100, 116, 139);"><p style="margin: 0px; font-weight: 700; color: rgb(30, 41, 59);">Klinik Raporlama</p><p style="margin: 0px;">Tarih: 18.09.2026</p></div></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(255, 247, 237); font-size: 10px; margin-bottom: 15px;"><span style="font-weight: 700; color: rgb(194, 65, 12); text-transform: uppercase; font-size: 8px; display: block; margin-bottom: 4px;">Klinik İzlenimler &amp; Bulgular</span><ul style="margin: 0px; padding-left: 15px; color: rgb(124, 45, 18); display: flex; flex-direction: column; gap: 3px;"><li style="line-height: 1.4;">Kritik Madde Uyarısı: İntihar riski veya depresyon ile ilişkili kritik maddelerden biri veya ikisi birden (Madde 202 veya Madde 339) doğrulanmıştır. Klinik değerlendirme ve yakın takip önerilir.</li><li style="line-height: 1.4;">Kritik Madde Uyarısı: Kendine veya başkasına zarar verme ile ilişkili kritik madde (Madde 139) doğrulanmıştır. Güvenlik önlemleri açısından klinik değerlendirme yapılması önerilir.</li><li style="line-height: 1.4;">F Ölçeği Bulgusu (Ciddi Psikopatoloji): F ölçeğindeki belirgin yükselmeyle (T &gt;= 80) birlikte 6 (Pa) ve 8 (Sc) ölçeklerinin yükselmesi, bireyde düşünce bozukluğu, ego işlevselliğinde bozulma veya akut psikotik süreçlerin varlığına işaret edebilir.</li><li style="line-height: 1.4;">Tedaviye Yanıt Notu (Reis, 1966): K ham puanının 15 ve altında olması, klinik olarak iyileşme oranının ve tedaviye/psikolojik müdahaleye olumlu yanıt verme olasılığının anlamlı derecede yüksek olduğuna işaret eder.</li></ul></div><div style="margin-bottom: 15px;"><h4 style="margin: 0px 0px 8px; font-size: 11px; font-weight: 700; color: rgb(30, 41, 59); border-bottom: 1px solid rgb(203, 213, 225); padding-bottom: 4px;">Kritik Patolojik Maddeler (33 Madde Tetiklendi)</h4><div style="border: 1px solid rgb(226, 232, 240); border-radius: 8px; overflow: hidden auto; font-size: 8.5px; max-height: 200px;"><table style="width: 100%; border-collapse: collapse; text-align: left;"><thead><tr style="background-color: rgb(248, 250, 252); border-bottom: 1px solid rgb(226, 232, 240); color: rgb(71, 85, 105);"><th style="padding: 4px 8px; font-weight: 700; width: 10%;">No</th><th style="padding: 4px 8px; font-weight: 700; width: 50%;">Soru Metni</th><th style="padding: 4px 8px; font-weight: 700; width: 15%; text-align: center;">Cevap</th><th style="padding: 4px 8px; font-weight: 700; width: 25%;">Klinik Kategori</th></tr></thead><tbody><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">27</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Ruhsal/Bilişsel Karmaşa</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">33</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Sosyal Çekilme</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">44</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Bedensel/Organik Yakınma</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">48</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Ruhsal Kontrol Kaybı</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">66</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Gerçek Dışılık / Sanrısal Düşünce</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">69</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Sosyal/Ailevi Huzursuzluk</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">85</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Ruhsal Sıkıntı / Kaygı</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">114</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Bedensel/Organik Belirti</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">121</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Gerçek Dışılık / Sanrısal Düşünce</td></tr><tr style="border-bottom: 1px solid rgb(241, 245, 249);"><td style="padding: 4px 8px; font-weight: 700;">123</td><td style="padding: 4px 8px; color: rgb(51, 65, 85);">""</td><td style="padding: 4px 8px; text-align: center; font-weight: 700; color: rgb(185, 28, 28);">DOĞRU</td><td style="padding: 4px 8px; color: rgb(100, 116, 139);">Şüphecilik / Alınganlık</td></tr><tr><td colspan="4" style="padding: 4px 8px; text-align: center; color: rgb(100, 116, 139); font-style: italic; background-color: rgb(248, 250, 252);">...ve diğer 23 kritik madde tetiklendi. (Tam liste dijital raporda mevcuttur)</td></tr></tbody></table></div></div><div style="display: flex; justify-content: flex-end; margin-top: 30px;"><div style="width: 180px; border: 1px solid rgb(203, 213, 225); border-radius: 6px; padding: 12px; text-align: center; font-size: 10px; background-color: rgb(248, 250, 252);"><p style="margin: 0px 0px 35px; color: rgb(100, 116, 139); font-weight: 700; text-transform: uppercase; font-size: 8px;">Raporu Onaylayan Uzman</p><p style="margin: 0px 0px 2px; font-weight: 700; color: rgb(15, 23, 42);">....................................</p><p style="margin: 0px; color: rgb(100, 116, 139); font-size: 9px;">İmza / Kaşe</p></div></div></div><div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(226, 232, 240); padding-top: 8px; font-size: 9px; color: rgb(100, 116, 139);"><span>MMPI Analiz Raporlama Sistemi | Danışan: Belirtilmedi</span><span>Sayfa 5 / 5</span></div></div></body></html>