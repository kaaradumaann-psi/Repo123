weight: 700; width: 25%;">Ölçek</th><th style="padding: 8px 12px; font-weight: 700; width: 15%; text-align: center;">Ham Puan</th><th style="padding: 8px 12px; font-weight: 700; width: 15%; text-align: center;">T Skoru</th><th style="padding: 8px 12px; font-weight: 700; width: 15%; text-align: center;">Seviye</th><th style="padding: 8px 12px; font-weight: 700; width: 30%;">Açıklama</th></tr></thead><tbody><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 8px 12px; font-weight: 700; color: rgb(13, 148, 136);">Bir Şey Diyemem (?) (?)</td><td style="padding: 8px 12px; text-align: center;">0</td><td style="padding: 8px 12px; text-align: center; font-weight: 700;">30</td><td style="padding: 8px 12px; text-align: center; font-weight: 700; color: rgb(59, 130, 246);">Normal</td><td style="padding: 8px 12px; font-size: 9px; color: rgb(71, 85, 105); line-height: 1.2;">Birey tüm soruları cevaplamıştır. Bu puan, çoğunlukla araştırma yapılan gruplard...</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 8px 12px; font-weight: 700; color: rgb(13, 148, 136);">Yalan (Lie) (L)</td><td style="padding: 8px 12px; text-align: center;">0</td><td style="padding: 8px 12px; text-align: center; font-weight: 700;">26.5</td><td style="padding: 8px 12px; text-align: center; font-weight: 700; color: rgb(59, 130, 246);">Çok Düşük</td><td style="padding: 8px 12px; font-size: 9px; color: rgb(71, 85, 105); line-height: 1.2;">Tüm maddeler doğrudur denebilir. Bağımsız, kendine güvenen, ufak sosyal hataları...</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 8px 12px; font-weight: 700; color: rgb(13, 148, 136);">Sıklık (Frequency) (F)</td><td style="padding: 8px 12px; text-align: center;">44</td><td style="padding: 8px 12px; text-align: center; font-weight: 700;">120</td><td style="padding: 8px 12px; text-align: center; font-weight: 700; color: rgb(239, 68, 68);">Çok Yüksek</td><td style="padding: 8px 12px; font-size: 9px; color: rgb(71, 85, 105); line-height: 1.2;">F alt testi 90 T puanını aşarsa bu profil dikkatli değerlendirilmelidir. F alt t...</td></tr><tr style="border-bottom: 1px solid rgb(226, 232, 240);"><td style="padding: 8px 12px; font-weight: 700; color: rgb(13, 148, 136);">Savunma (Correction) (K)</td><td style="padding: 8px 12px; text-align: center;">8</td><td style="padding: 8px 12px; text-align: center; font-weight: 700;">37.1</td><td style="padding: 8px 12px; text-align: center; font-weight: 700; color: rgb(59, 130, 246);">Düşük</td><td style="padding: 8px 12px; font-size: 9px; color: rgb(71, 85, 105); line-height: 1.2;">Düşük sosyo-ekonomik düzeyden gelen bireylerde gözlenebilir. Bu hastalar sınırlı...</td></tr></tbody></table></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 15px; background-color: rgb(248, 250, 252); font-size: 11px; margin-bottom: 20px;"><h4 style="margin: 0px 0px 8px; color: rgb(30, 41, 59); font-weight: 700; border-bottom: 1px solid rgb(203, 213, 225); padding-bottom: 4px;">Bütüncül Geçerlik Değerlendirmesi</h4><p style="margin: 0px; color: rgb(51, 65, 85); line-height: 1.5; text-align: justify;">Yorumlama sırasında geçerlik ölçeklerindeki (L, F, K) uyarılar dikkate alınmalıdır. Ancak, hiçbir uyarı tek başına profili "geçersiz" yapmaz. Tüm bulgular (SES, hastanın durumu, okuma becerisi) bütüncül değerlendirilmelidir.</p></div><div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; font-size: 10px;"><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block; margin-bottom: 4px;">TR Endeksi</span><span style="font-size: 14px; font-weight: 800; color: rgb(15, 23, 42);">2</span><p style="margin: 6px 0px 0px; color: rgb(71, 85, 105); line-height: 1.3; font-size: 9px;">TR endeksinin 3 puan ya da daha az olması, yanıtların tutarlı olduğunu gösterir. Gravitz ve Gerton (1976), normal bireylerin tekrarlanan maddelerin sadece üç, dördüne değişik yanıtlar verdiklerini belirlemişlerdir. Bu seviyedeki düşük tutarsızlıklar genellikle dikkatsizlik nedeniyle ortaya çıkar.</p></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block; margin-bottom: 4px;">Dikkatsizlik Endeksi</span><span style="font-size: 14px; font-weight: 800; color: rgb(15, 23, 42);">4</span><p style="margin: 6px 0px 0px; color: rgb(71, 85, 105); line-height: 1.3; font-size: 9px;">Dikkatsizlik puanının 4 veya üzerinde olması, saptırılmış test davranışının ortaya çıkarılmasını mümkün kılar. Bu durum; hastaların testi tamamlamaya karşı isteksizliğini, beceri eksikliğini veya konfüzyon (zihinsel karışıklık) durumunu yansıtıyor olabilir. Greene (1980) 4 puanı kesim noktası olarak belirlemiştir. Bu seviyedeki bir puan, test bulgularının değerlendirilmesinde dikkatli olunması gerektiğini gösterir.</p></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; padding: 12px; background-color: rgb(255, 255, 255);"><span style="font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; font-size: 8px; display: block; margin-bottom: 4px;">F-K İndeksi</span><span style="font-size: 14px; font-weight: 800; color: rgb(239, 68, 68);">36</span><p style="margin: 6px 0px 0px; color: rgb(71, 85, 105); line-height: 1.3; font-size: 9px;">F-K endeksi 16'nın üzerindedir. Bu durum, test bulgularının değerlendirilmesinde son derece dikkatli olmayı gerektirir. Standart değerlendirme hastanın gerçek durumunu yansıtmayabilir. Bu veri için olası iki açıklama mevcuttur:
- Hasta akut bir psikotik konfüzyon/bozukluk yaşamaktadır ve testi içinde bulunduğu kafa karışıklığına bağlı olarak sağlıklı tamamlayamamıştır. Klinik düzelme gerçekleştikten sonra test yinelenmelidir.
- Birey bilinçli olarak durumunu aşırı şekilde abartmaktadır (simülasyon).</p></div></div></div><div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgb(226, 232, 240); padding-top: 8px; font-size: 9px; color: rgb(100, 116, 139);"><span>MMPI Analiz Raporlama Sistemi | Danışan: Belirtilmedi</span><span>Sayfa 2 / 5</span></div></div><div class="pdf-report-page" style="width: 794px; height: 1123px; padding: 50px 45px 40px; background-color: rgb(255, 255, 255); color: rgb(15, 23, 42); font-family: system-ui, -apple-system, sans-serif; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; position: relative;"><div><div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid rgb(13, 148, 136); padding-bottom: 10px; margin-bottom: 20px;"><div><h1 style="margin: 0px; font-size: 18px; font-weight: 900; color: rgb(13, 148, 136); letter-spacing: -0.5px;">MMPI KİŞİLİK ENVANTERİ</h1><p style="margin: 2px 0px 0px; font-size: 9px; font-weight: 700; color: rgb(100, 116, 139); text-transform: uppercase; letter-spacing: 1px;">Klinik Ölçekler Değerlendirmesi</p></div><div style="text-align: right; font-size: 9px; color: rgb(100, 116, 139);"><p style="margin: 0px; font-weight: 700; color: rgb(30, 41, 59);">Klinik Raporlama</p><p style="margin: 0px;">Tarih: 18.09.2026</p></div></div><div style="border: 1px solid rgb(203, 213, 225); border-radius: 8px; overflow: hidden; margin-bottom: 20px; font-size: 9px;"><table style="width: 100%; border-collapse: collapse; text-align: left;"><thead><tr style="background-color: rgb(248, 250, 252); border-bottom: 1px solid rgb(203, 213, 225); color: rgb(71, 85, 105);"><th style="padding: 6px 10px; font-weight: 700; width: 30%;">Klinik Ölçek</th><th style="padding: 6px 10px; font-weight: 700; width: 12%; text-align: center;">Ham Puan</th><th style="padding: 6px 10px; font-weight: 700; width: 15%; text-align: center;">K-Dü